# ClauseTrace environment configuration.
# `.env` is gitignored so your keys are never committed.

# Provider choice: "mock" (built-in demo data) or "gemini" (Google Gemini API)
VITE_AI_PROVIDER=mock

# Gemini Model ID
VITE_GEMINI_MODEL=gemini-2.0-flash

# PASTE YOUR GEMINI API KEY HERE:
VITE_GEMINI_API_KEY=

# Server-side proxy URL (Optional, if proxying requests through a server):
# VITE_AI_PROXY_URL=http://localhost:8787/api/ai

